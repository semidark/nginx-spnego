##
# Default server configuration for nginx-spnego auth-gateway
#

##
# Redirect HTTP to HTTPS
#
server {
    listen 80 default_server;
    server_name _;

    # Redirect all HTTP requests to HTTPS
    return 301 https://$host$request_uri;
}

##
# HTTPS server with SPNEGO/Kerberos authentication
#
server {
    listen 443 ssl default_server;
    server_name _;

    # TLS Configuration
    ssl_certificate /etc/nginx/ssl/nginx.crt;
    ssl_certificate_key /etc/nginx/ssl/nginx.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Use custom auth log format
    access_log /dev/stdout auth_log;
    error_log /var/log/nginx/error.log debug;

    ##
    # Internal location for LDAP authorization check
    ##
    location = /_ldap_auth {
        internal;
        
        proxy_pass http://127.0.0.1:8888/check-header;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        
        # Pass the Kerberos-authenticated username
        proxy_set_header X-Ldap-User $remote_user;
        
        # Pass original request info for logging
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        
        # Optional: Override authorization filter per-location
        # proxy_set_header X-Authorization-Filter "(memberOf=CN=SomeGroup,OU=Groups,DC=...)";
        
        # Cache auth responses briefly in NGINX
        proxy_cache_valid 200 1m;
        proxy_cache_valid 403 1m;
    }

    ##
    # Internal location: resolves/creates the per-user LiteLLM virtual key
    ##
    location = /_litellm_key_broker {
        internal;
        proxy_pass http://127.0.0.1:8889/resolve;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Forwarded-User $remote_user;
    }

    ##
    # LiteLLM proxy — OpenAI-compatible API endpoints
    # Requires Kerberos/SPNEGO auth; injects per-user virtual key via key-broker.
    # Admin tasks (key management, spend reporting) are done via curl with the master key.
    ##
    location /litellm/ {
        # Kerberos/SPNEGO authentication
        auth_gss on;
        auth_gss_keytab /etc/nginx/keytab/nginx.keytab;
        auth_gss_realm $gss_realm;
        auth_gss_format_full on;
        auth_gss_allow_basic_fallback off;

        # Resolve per-user LiteLLM key via key-broker
        auth_request /_litellm_key_broker;
        auth_request_set $litellm_key $upstream_http_x_litellm_key;

        # Proxy to LiteLLM, replacing Authorization header with virtual key
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-User $remote_user;
        proxy_set_header Authorization "Bearer $litellm_key";

        # SSE / streaming support
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    ##
    # Protected area - requires Kerberos auth + Zulassung group membership
    ##
    location /protected/ {
        # OPTIONS preflight exemption — return 204 without auth
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  $http_origin;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS";
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept";
            add_header Access-Control-Max-Age       600;
            add_header Content-Length               0;
            return 204;
        }

        # First: Kerberos authentication (already configured)
        auth_gss on;
        auth_gss_keytab /etc/nginx/keytab/nginx.keytab;
        auth_gss_realm $gss_realm;
        auth_gss_format_full on;
        auth_gss_allow_basic_fallback off;
        
        # Second: LDAP group authorization
        auth_request /_ldap_auth;
        auth_request_set $auth_status $upstream_status;
        
        # Custom error pages for auth failures
        error_page 401 /401.html;
        error_page 403 /403.html;
        
        # Pass authenticated user to backend
        proxy_set_header X-Remote-User $remote_user;
        proxy_set_header X-Auth-Status $auth_status;
        
        ssi on; # Just for testing. Disable for production.

        # Serve static content or proxy to backend
        alias /var/www/html/protected/;
        index index.html;
        try_files $uri $uri/ =404;
    }

    ##
    # Public area - Kerberos auth only, no group restriction
    ##
    location / {
        ssi on; # Just for testing. Disable for production.
    
        root /var/www/html;
        index index.html;

        # Enable GSSAPI/SPNEGO authentication
        auth_gss on;
        # Path to keytab file (must have read permissions for www-data user)
        auth_gss_keytab /etc/nginx/keytab/nginx.keytab;
        auth_gss_allow_basic_fallback off;
        
        # Enable Domain in username Variable
        auth_gss_format_full on;
        
        try_files $uri $uri/ =404;
    }

    ##
    # Error pages for authentication/authorization failures
    ##
    location = /401.html {
        internal;
        return 401 'Authentication required. Please authenticate with Kerberos.';
        add_header Content-Type text/plain;
    }

    location = /403.html {
        internal;
        return 403 'Access denied. You are not a member of the required group.';
        add_header Content-Type text/plain;
    }

