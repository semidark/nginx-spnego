##
# Default server configuration for nginx-spnego auth-gateway
#

##
# Redirect HTTP to HTTPS
#
server {
    listen 80 default_server;
    server_name _;

    # Health check endpoint (no auth, no TLS required)
    location /health {
        auth_gss off;
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # Redirect all other HTTP requests to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

##
# HTTPS server with SPNEGO/Kerberos authentication
#
server {
    listen 443 ssl default_server;
    server_name _;

    # TLS Configuration
    ssl_certificate /etc/nginx/ssl/nginx.crt;
    ssl_certificate_key /etc/nginx/ssl/nginx.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Health check endpoint (no auth required)
    location /health {
        auth_gss off;
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # Authenticated reverse proxy
    location / {
        # Enable GSSAPI/SPNEGO authentication
        auth_gss on;
        # Path to keytab file (must have read permissions for www-data user)
        auth_gss_keytab /etc/nginx/keytab/nginx.keytab;
        # Include domain in username
        auth_gss_format_full on;

        # Forward requests to backend server
        proxy_pass http://backend_server;

        # Preserve client headers and IP
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Pass the authenticated username to backend
        proxy_set_header X-Remote-User $remote_user;
    }
}
