# =============================================================================
# nginx-spnego Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Required: Kerberos Configuration
# -----------------------------------------------------------------------------

# Kerberos realm (uppercase). Must match your AD/FreeIPA domain.
# Example: CORP.EXAMPLE.COM
KRB5_REALM=

# Kerberos KDC (Key Distribution Center) hostname.
# This is typically your Active Directory domain controller or FreeIPA server.
# Example: dc01.corp.example.com
KRB5_KDC=

# -----------------------------------------------------------------------------
# Optional: Kerberos Configuration
# -----------------------------------------------------------------------------

# Kerberos admin server hostname. Defaults to KRB5_KDC if not set.
# KRB5_ADMIN_SERVER=dc01.corp.example.com

# DNS domain for Kerberos domain_realm mapping.
# Defaults to lowercase of KRB5_REALM if not set.
# KRB5_DOMAIN=corp.example.com

# -----------------------------------------------------------------------------
# Optional: TLS Configuration
# -----------------------------------------------------------------------------

# Hostname for the self-signed TLS certificate.
# Only used when no real certificates are mounted.
# Defaults to the container hostname.
# SSL_HOSTNAME=proxy.corp.example.com

# -----------------------------------------------------------------------------
# Optional: Keytab Configuration
# -----------------------------------------------------------------------------

# Path to the Kerberos keytab file inside the container.
# KEYTAB_PATH=/etc/nginx/keytab/nginx.keytab

# Seconds to wait for the keytab file to appear before failing.
# KEYTAB_WAIT_TIMEOUT=120

# -----------------------------------------------------------------------------
# Optional: Logging
# -----------------------------------------------------------------------------

# NGINX error log level. Valid values: debug, info, notice, warn, error, crit, alert, emerg
# Default: warn
# NGINX_LOG_LEVEL=warn
